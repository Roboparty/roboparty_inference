#!/usr/bin/make -f
export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = optimize=-lto
export AMENT_PREFIX_PATH=/opt/ros/jazzy
export CMAKE_PREFIX_PATH=/opt/roboparty:/opt/ros/jazzy
export PYTHONPATH=/opt/ros/jazzy/lib/python3.12/site-packages:/opt/ros/jazzy/local/lib/python3.12/dist-packages
export LD_LIBRARY_PATH := /opt/ros/jazzy/lib:$(LD_LIBRARY_PATH)
export CCACHE_DISABLE = 1

PKG_NAME = roboparty-inference

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	# Extract yaml-cpp for offline builds.
	if [ ! -d "thirdparty/yaml-cpp-0.9.0" ] && [ -f "thirdparty/yaml-cpp-0.9.0.tar.gz" ]; then \
		mkdir -p "thirdparty/yaml-cpp-0.9.0" && tar xzf "thirdparty/yaml-cpp-0.9.0.tar.gz" -C "thirdparty/yaml-cpp-0.9.0" --strip-components=1; \
	fi
	
	dh_auto_configure -- \
		-DCMAKE_INSTALL_PREFIX=/opt/roboparty \
		-DCMAKE_PREFIX_PATH="/opt/roboparty;/opt/ros/jazzy" \
		-DFETCHCONTENT_SOURCE_DIR_YAML-CPP="$$(pwd)/thirdparty/yaml-cpp-0.9.0" \
		-DCMAKE_BUILD_TYPE=Release

override_dh_install:
	dh_install
	
	# robot profiles
	if [ -d "debian/$(PKG_NAME)/opt/roboparty/share/roboparty_inference/robots" ]; then \
		find debian/$(PKG_NAME)/opt/roboparty/share/roboparty_inference/robots -type f \( -name "*.yaml" -o -name "*.onnx" -o -name "*.npz" \) -exec chmod 644 {} \; ; \
	fi
	
	# Remove helper scripts
	rm -f debian/$(PKG_NAME)/opt/roboparty/bin/mat2npz debian/$(PKG_NAME)/opt/roboparty/bin/npy2mat debian/$(PKG_NAME)/opt/roboparty/bin/npz2mat
	# Debian packages use the separately managed roboparty-onnxruntime package.
	rm -rf debian/$(PKG_NAME)/opt/roboparty/lib/roboparty_inference/onnxruntime

override_dh_shlibdeps:
	dh_shlibdeps -- $(foreach dir,$(wildcard $(CURDIR)/obj-*/thirdparty/onnxruntime-bundled/onnxruntime-linux-*-1.21.0/lib),-l$(dir)) -l/opt/roboparty/lib
